{
  "includeVBTextures" : false,

  // No "frameBuffer" declared: like "interface", the pass is on the screen until the caller sets a
  // target. BackdropPass::mergedCompose() does setRenderTarget("main") after switchEffectConfig, so the
  // merged compose writes "main". (Declaring "frameBuffer":"main" would also work; omitting it keeps this
  // effect from binding any target on its own.)

  "effectTextures" : {
    "envTexture" : {
      "textureUniform" : "envTexture",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    },
    "parallaxTexture" : {
      "textureUniform" : "parallaxTexture",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    }
  },

  "effectShaders" : {
    "vertex" : "backdropCompose.vert",
    "fragment" : "backdropCompose.frag"
  }
}
