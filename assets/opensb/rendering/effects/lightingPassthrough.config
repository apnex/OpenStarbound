{
  "includeVBTextures" : false,

  "frameBuffer" : "lightingGpu",

  // NOTE: no "screenSize" effectParameter. The renderer owns that uniform (GlPass caches its location and
  // writes it on every bind and every setRenderTarget). Declaring it here resolved a SECOND location for the
  // same uniform and pinned its default of [1,1] into the effect's parameter cache -- a second owner for a
  // value the pass already owns. It was inert only because setRenderTarget rewrites the real one before every
  // draw.
  "effectParameters" : {
    "applyCap" : { "type" : "bool", "default" : false, "uniform" : "applyCap" },
    "brightnessLimit" : { "type" : "float", "default" : 1.4, "uniform" : "brightnessLimit" },
    "brightnessScale" : { "type" : "float", "default" : 1.0, "uniform" : "brightnessScale" },
    "tonemap" : { "type" : "bool", "default" : false, "uniform" : "tonemap" },
    "preserveAlpha" : { "type" : "bool", "default" : false, "uniform" : "preserveAlpha" }
  },

  "effectTextures" : {
    "inputTexture" : {
      "textureUniform" : "inputTexture",
      "textureSizeUniform" : "inputTextureSize",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    }
  },

  "effectShaders" : {
    "vertex" : "lightingPassthrough.vert",
    "fragment" : "lightingPassthrough.frag"
  }
}
