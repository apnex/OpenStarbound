{
  "includeVBTextures" : false,

  "frameBuffer" : "lightingGpuUpscaled",

  // NOTE: no "screenSize" effectParameter, and no effectParameters at all. The renderer owns that uniform --
  // GlPass caches its location and writes it on every bind and every setRenderTarget. Declaring it here
  // resolved a SECOND location for the same uniform and pinned its default of [1,1] into the effect's
  // parameter cache. Inert only because setRenderTarget rewrites the real one before every draw.

  "effectTextures" : {
    "inputTexture" : {
      "textureUniform" : "inputTexture",
      "textureSizeUniform" : "inputTextureSize",
      "textureAddressing" : "clamp",
      "textureFiltering" : "linear"
    }
  },

  "effectShaders" : {
    "vertex" : "lightingPassthrough.vert",
    "fragment" : "lightingUpscale.frag"
  }
}
