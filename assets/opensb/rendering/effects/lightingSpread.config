{
  "includeVBTextures" : false,

  "effectParameters" : {
    "dropoffAir" : { "type" : "float", "default" : 0.125, "uniform" : "dropoffAir" },
    "dropoffObstacle" : { "type" : "float", "default" : 0.5, "uniform" : "dropoffObstacle" },
    "applyCap" : { "type" : "bool", "default" : false, "uniform" : "applyCap" },
    "brightnessLimit" : { "type" : "float", "default" : 1.4, "uniform" : "brightnessLimit" }
  },

  "effectTextures" : {
    "emission" : {
      "textureUniform" : "emission",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    },
    "lightState" : {
      "textureUniform" : "lightState",
      "textureSizeUniform" : "lightStateSize",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    },
    "obstacle" : {
      "textureUniform" : "obstacle",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    }
  },

  "effectShaders" : {
    "vertex" : "lightingSpread.vert",
    "fragment" : "lightingSpread.frag"
  }
}
